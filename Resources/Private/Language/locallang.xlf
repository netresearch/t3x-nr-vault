<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" datatype="plaintext" original="messages" date="2024-12-28T00:00:00Z" product-name="nr_vault">
        <header/>
        <body>
            <trans-unit id="vault_secret.placeholder_exists">
                <source>Secret stored in vault (enter new value to update)</source>
            </trans-unit>

            <!-- DataHandler hooks: vault operation failure -->
            <trans-unit id="hook.vaultFailure.reference">
                <source>The vault operation could not be completed. Please ask an administrator to check the vault log for reference %s.</source>
            </trans-unit>

            <!-- Scheduler Task: Orphan Cleanup -->
            <trans-unit id="task.orphanCleanup.title">
                <source>Vault Orphan Cleanup</source>
            </trans-unit>
            <trans-unit id="task.orphanCleanup.description">
                <source>Removes vault secrets whose source TCA records have been deleted. Helps maintain vault hygiene and prevent accumulation of unused encrypted data.</source>
            </trans-unit>
            <trans-unit id="task.orphanCleanup.retentionDays">
                <source>Retention days</source>
            </trans-unit>
            <trans-unit id="task.orphanCleanup.retentionDays.description">
                <source>Keep orphans for this many days before deletion. Set to 0 to delete immediately. Default: 7 days.</source>
            </trans-unit>
            <trans-unit id="task.orphanCleanup.tableFilter">
                <source>Table filter</source>
            </trans-unit>
            <trans-unit id="task.orphanCleanup.tableFilter.description">
                <source>Optional: Only check secrets from this specific table. Leave empty to check all tables.</source>
            </trans-unit>
        </body>
    </file>
